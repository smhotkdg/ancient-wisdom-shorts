# 비밀
.env

# 미디어·빌드 결과 (로컬 전용) — images/, clips/ 폴더는 .gitkeep 으로 빈 폴더만 올린다
episodes/*/audio/
episodes/*/images/*
!episodes/*/images/.gitkeep
episodes/*/clips/*
!episodes/*/clips/.gitkeep
episodes/*/build/
episodes/*/output/*
!episodes/*/output/youtube.txt
episodes/_selftest/

# 폰트·BGM 파일은 각 PC에 둔다
fonts/*
!fonts/README.md
assets/bgm/*
!assets/bgm/README.md

__pycache__/
*.pyc
.DS_Store
Thumbs.db

# 다른 에이전트용 규칙 복사본 (원본은 CLAUDE.md, .claude/skills)
.agents/
